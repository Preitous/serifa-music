/* ==========================================
   BARRAS DE ROLAGEM
   ========================================== */

QScrollBar:vertical {
    background: #211e2a;
    width: 7px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #59496b;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #80649e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}


